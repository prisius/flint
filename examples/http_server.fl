// A small HTTP/1.1 server using std/net.
//
//   ./flint run examples/http_server.fl            (port 8080)
//   ./flint run examples/http_server.fl -- 3000    (custom port)
//
// Then open http://localhost:8080 or try:
//   curl localhost:8080/hello?name=Ada
//   curl localhost:8080/stats
import "std/net"

struct Request {
    method: str
    path: str   // without the query string
    query: str  // the part after '?', or ""
}

struct Response {
    status: i32
    content_type: str
    body: str
}

struct Server {
    requests: i64
    not_found: i64
}

fn reason(status: i32) -> str {
    match status {
        200 => return "OK"
        400 => return "Bad Request"
        404 => return "Not Found"
        405 => return "Method Not Allowed"
        _ => return "Error"
    }
}

// "GET /hello?name=Ada HTTP/1.1\r\n..." -> Request. Returns false if malformed.
fn parse_request(raw: str, req: *Request) -> bool {
    let end = raw.find("\r\n")
    if end < 0 {
        return false
    }
    var parts = raw[..end].split(" ")
    defer free(parts)
    if parts.len != 3 || !parts[2].starts_with("HTTP/") {
        return false
    }
    req.method = parts[0]
    let target = parts[1]
    let q = target.find("?")
    if q >= 0 {
        req.path = target[..q]
        req.query = target[q + 1..]
    } else {
        req.path = target
        req.query = ""
    }
    return true
}

// Value of `key` in "a=1&b=2", or "" when missing.
fn query_param(query: str, key: str) -> str {
    var pairs = query.split("&")
    defer free(pairs)
    for p in pairs {
        let eq = p.find("=")
        if eq > 0 && p[..eq] == key {
            return p[eq + 1..]
        }
    }
    return ""
}

// Only letters, digits, '-' and '_': safe to put into HTML as-is.
fn is_safe_name(s: str) -> bool {
    if s.len == 0 || s.len > 40 {
        return false
    }
    for c in s {
        let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_'
        if !ok {
            return false
        }
    }
    return true
}

const INDEX_HTML = "<!doctype html><html><head><title>Flint</title></head><body><h1>Hello from Flint!</h1><ul><li><a href=\"/hello?name=Ada\">/hello?name=Ada</a></li><li><a href=\"/stats\">/stats</a></li></ul></body></html>"

impl Server {
    // Bodies built with "{...}" are heap strings; the caller frees resp.body when owned is true.
    fn route(self, req: Request, owned: *bool) -> Response {
        self.requests += 1
        if req.method != "GET" {
            return Response { status: 405, content_type: "text/plain", body: "only GET is supported\n" }
        }
        match req.path {
            "/" => return Response { status: 200, content_type: "text/html", body: INDEX_HTML }
            "/hello" => {
                var name = query_param(req.query, "name")
                if !is_safe_name(name) {
                    name = "stranger"
                }
                *owned = true
                return Response { status: 200, content_type: "text/html", body: "<h1>Hello, {name}!</h1>\n" }
            }
            "/stats" => {
                *owned = true
                return Response {
                    status: 200,
                    content_type: "application/json",
                    body: "{{\"requests\": {self.requests}, \"not_found\": {self.not_found}}}\n",
                }
            }
            _ => {
                self.not_found += 1
                return Response { status: 404, content_type: "text/plain", body: "not found\n" }
            }
        }
    }
}

fn handle(server: *Server, conn: TcpConn) {
    var buf: [8192]char
    let raw = conn.read(buf)
    if raw.len == 0 {
        return
    }
    var req: Request
    var owned = false
    var resp: Response
    if parse_request(raw, &req) {
        resp = server.route(req, &owned)
    } else {
        resp = Response { status: 400, content_type: "text/plain", body: "bad request\n" }
    }
    defer {
        if owned {
            free(resp.body)
        }
    }

    let head = "HTTP/1.1 {resp.status} {reason(resp.status)}\r\nContent-Type: {resp.content_type}; charset=utf-8\r\nContent-Length: {resp.body.len}\r\nConnection: close\r\n\r\n"
    defer free(head)
    if conn.write(head) {
        conn.write(resp.body)
    }
    eprintln("{req.method:-4} {req.path:-12} -> {resp.status}")
}

fn main(args: []str) {
    var port = 8080
    if args.len > 1 {
        port = parse_int(args[1])
    }
    let listener = TcpListener.bind(port as i32)
    println("listening on http://localhost:{port}  (Ctrl-C to stop)")
    var server: Server
    while true {
        var conn = listener.accept()
        if !conn.ok() {
            continue
        }
        handle(&server, conn)
        conn.close()
    }
}
