// Conway's Game of Life on a fixed-size grid (fixed arrays live on the stack: no allocation).
const W = 20
const H = 10

struct World {
    cells: [H][W]bool
}

impl World {
    fn alive_neighbors(self, y: i64, x: i64) -> i32 {
        var n = 0
        for dy in -1..2 {
            for dx in -1..2 {
                if dy == 0 && dx == 0 { continue }
                let yy = (y + dy + H) % H
                let xx = (x + dx + W) % W
                if self.cells[yy][xx] { n += 1 }
            }
        }
        return n
    }

    fn step(self) -> World {
        var next: World
        for y in 0..H {
            for x in 0..W {
                let n = self.alive_neighbors(y, x)
                let alive = self.cells[y][x]
                next.cells[y][x] = n == 3 || (alive && n == 2)
            }
        }
        return next
    }

    fn show(self) {
        for row in self.cells {
            for c in row {
                if c { print("#") } else { print(".") }
            }
            println()
        }
    }
}

fn main() {
    var w: World
    // a glider
    w.cells[0][1] = true
    w.cells[1][2] = true
    w.cells[2][0] = true
    w.cells[2][1] = true
    w.cells[2][2] = true
    for gen in 0..4 {
        println("generation {gen}:")
        w.show()
        w = w.step()
    }
}
